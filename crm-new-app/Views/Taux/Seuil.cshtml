@{
    ViewData["Title"] = "Définir un Seuil";
}

<div class="container mt-5">
    <div class="card shadow-lg p-4 bg-white rounded">
        <h2 class="text-center text-primary mb-4">Définir un Seuil</h2>

        @* @if (TempData["SuccessMessage"] != null) *@
        @* { *@
        @*     <div class="alert alert-success text-center"> *@
        @*         @TempData["SuccessMessage"] *@
        @*     </div> *@
        @* } *@
        @* *@
        @* @if (TempData["ErrorMessage"] != null) *@
        @* { *@
        @*     <div class="alert alert-danger text-center"> *@
        @*         @TempData["ErrorMessage"] *@
        @*     </div> *@
        @* } *@


        <form method="post" action="/Taux/UpdateTaux">
            <div class="mb-3">
                <label for="newTaux" class="form-label fw-bold">Seuil (%) :</label>
                <input type="number" name="newTaux" id="newTaux" class="form-control border-primary" 
                       min="0" max="100" step="0.01" required placeholder="Entrez un pourcentage..." />
            </div>

            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-primary btn-lg px-5">Modifier</button>
            </div>
        </form>
    </div>
</div>